rules_version = '2';

// Every synced record (teams, opponents, their delete-tombstones, and the
// small meta/state doc — see src/lib/storage/db.ts and
// src/lib/firebase/cloudSync.ts) lives under users/{uid}/, so one recursive
// rule covers all of it: a signed-in user may only read/write their own tree.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared, public default-team-set data (see src/data/regulations for the
    // Regulation this belongs under, src/types/season.ts, and the
    // /admin/seasons editor) — every visitor reads it, only the admin
    // account writes. Keep this uid in sync with NEXT_PUBLIC_ADMIN_UID.
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "YAVX7lLqGZTnzZm2TXdBMcNB1B92";
    }

    // Public copies of shared Team Reports (see src/types/team.ts's
    // SharedTeam and src/lib/firebase/sharedTeams.ts) — anyone with the link
    // reads one; only the signed-in owner named in the doc writes it, and an
    // update can't hand it to someone else. Deleting a doc that doesn't exist
    // is allowed so "make private" is safe to repeat.
    match /sharedTeams/{teamId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == teamId;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == teamId;
      allow delete: if request.auth != null
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    // Prep groups (docs/prep-groups.md, src/lib/firebase/groups.ts): a shared
    // opponent list for an event. Members read and edit it; each member's
    // picks and notes live in their own users/{uid}/groupPlans, not here.
    function signedIn() {
      return request.auth != null;
    }
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).memberUids;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.id == groupId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if signedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // The owner edits anything but ownership.
          resource.data.ownerUid == request.auth.uid
          // A member leaves: only their own membership goes.
          || (request.auth.uid in resource.data.memberUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'members', 'updatedAt'])
            && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.members.diff(resource.data.members).affectedKeys()
              .hasOnly([request.auth.uid]))
          // Someone with the invite link joins: only their own membership is
          // added, and the code they send must be an invite for this group.
          || (!(request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'members', 'updatedAt', 'joinCode'])
            && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
            && request.resource.data.members.diff(resource.data.members).affectedKeys()
              .hasOnly([request.auth.uid])
            && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.joinCode))
              .data.groupId == groupId)
        );

      // Shared opponents: any member adds (as themselves) and edits them;
      // only whoever added one, or the group's owner, removes it.
      match /opponents/{opponentId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.id == opponentId
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if isGroupMember(groupId)
          && request.resource.data.id == opponentId
          && request.resource.data.addedBy == resource.data.addedBy;
        allow delete: if isGroupMember(groupId)
          && (resource.data.addedBy == request.auth.uid
            || groupData(groupId).ownerUid == request.auth.uid);
      }
    }

    // Invite links: knowing the code is the access, so a signed-in user can
    // get one by its code but nobody can list them. Only the group's owner
    // creates or removes them.
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && groupData(request.resource.data.groupId).ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && groupData(resource.data.groupId).ownerUid == request.auth.uid;
    }

    // The admin's public Damage Calculator sets (src/types/calcSet.ts,
    // src/lib/firebase/publicSets.ts) — same everyone-reads/admin-writes
    // shape as seasons. A user's own sets live under users/{uid}/calcSets,
    // covered by the rule at the top. Keep this uid in sync with
    // NEXT_PUBLIC_ADMIN_UID.
    match /publicSets/{setId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "YAVX7lLqGZTnzZm2TXdBMcNB1B92";
    }

    // Admin-controlled per-section on/off switches (see src/types/featureFlags.ts,
    // src/lib/firebase/featureFlags.ts, and /admin/features) — same
    // everyone-reads/admin-writes shape as seasons above. Keep this uid in
    // sync with NEXT_PUBLIC_ADMIN_UID.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "YAVX7lLqGZTnzZm2TXdBMcNB1B92";
    }
  }
}
