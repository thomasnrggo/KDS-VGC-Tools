rules_version = '2';

// Every synced record (teams, opponents, their delete-tombstones, and the
// small meta/state doc — see src/lib/storage/db.ts and
// src/lib/firebase/cloudSync.ts) lives under users/{uid}/, so one recursive
// rule covers all of it: a signed-in user may only read/write their own tree.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Roles (src/lib/admin.ts, /admin/users): staff have a roles/{uid} doc —
    // "moderator" keeps the shared data (seasons, public calc sets, meta
    // sets, learnsets); "admin" also manages feature flags and roles. The
    // first admin's doc is created outside the app (`npm run set-role`, or
    // the console), which these rules don't apply to.
    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function hasRole(roles) {
      return request.auth != null && exists(roleDoc()) && get(roleDoc()).data.role in roles;
    }
    function isAdmin() {
      return hasRole(['admin']);
    }
    function isStaff() {
      return hasRole(['admin', 'moderator']);
    }

    // Each person reads their own role (that's how the app knows it);
    // admins read and set everyone's, but not their own — no admin can
    // demote or remove themselves by accident.
    match /roles/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.role in ['moderator', 'admin'];
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Who has signed in (src/lib/firebase/roles.ts's UserProfile), so an
    // admin can find someone by email at /admin/users. Each person writes
    // only their own; only admins read them.
    match /profiles/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Shared, public default-team-set data (see src/data/regulations for the
    // Regulation this belongs under, src/types/season.ts, and the
    // /admin/seasons editor) — every visitor reads it, staff write it.
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public copies of shared Team Reports (see src/types/team.ts's
    // SharedTeam and src/lib/firebase/sharedTeams.ts) — anyone with the link
    // reads one; only the signed-in owner named in the doc writes it, and an
    // update can't hand it to someone else. Deleting a doc that doesn't exist
    // is allowed so "make private" is safe to repeat.
    match /sharedTeams/{teamId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == teamId;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == teamId;
      allow delete: if request.auth != null
        && (resource == null || resource.data.ownerUid == request.auth.uid);

      // A shared team's matchups (docs/full-share.md, SharedMatchup): public
      // like the team; only the team doc's owner writes them — so they're
      // published after it and removed before it.
      match /matchups/{opponentId} {
        allow read: if true;
        allow write: if request.auth != null
          && exists(/databases/$(database)/documents/sharedTeams/$(teamId))
          && get(/databases/$(database)/documents/sharedTeams/$(teamId)).data.ownerUid
            == request.auth.uid;
      }
    }

    // Prep groups (docs/prep-groups.md, src/lib/firebase/groups.ts): a shared
    // opponent list for an event. Members read and edit it; each member's
    // picks and notes live in their own users/{uid}/groupPlans, not here.
    function signedIn() {
      return request.auth != null;
    }
    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function isGroupMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).memberUids;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.id == groupId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if signedIn()
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          // The owner edits anything but ownership.
          resource.data.ownerUid == request.auth.uid
          // A member leaves: only their own membership goes.
          || (request.auth.uid in resource.data.memberUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'members', 'updatedAt'])
            && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.members.diff(resource.data.members).affectedKeys()
              .hasOnly([request.auth.uid]))
          // Someone with the invite link joins: only their own membership is
          // added, and the code they send must be an invite for this group.
          || (!(request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'members', 'updatedAt', 'joinCode'])
            && request.resource.data.memberUids.toSet()
              == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
            && request.resource.data.members.diff(resource.data.members).affectedKeys()
              .hasOnly([request.auth.uid])
            && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.joinCode))
              .data.groupId == groupId)
        );

      // Shared opponents: any member adds (as themselves) and edits them;
      // only whoever added one, or the group's owner, removes it.
      match /opponents/{opponentId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.id == opponentId
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if isGroupMember(groupId)
          && request.resource.data.id == opponentId
          && request.resource.data.addedBy == resource.data.addedBy;
        allow delete: if isGroupMember(groupId)
          && (resource.data.addedBy == request.auth.uid
            || groupData(groupId).ownerUid == request.auth.uid);
      }

      // A collaborative team's group (docs/collaborative-teams.md): the one
      // plan every member shares for each opponent. Only on a team's group —
      // an ordinary group's plans stay in each member's users/{uid}/groupPlans.
      match /plans/{opponentId} {
        allow read: if isGroupMember(groupId);
        allow write: if isGroupMember(groupId) && 'teamId' in groupData(groupId);
      }
    }

    // Collaborative teams (docs/collaborative-teams.md, src/lib/firebase/
    // collabTeams.ts): edited by the members of the team's group. Only that
    // group's owner creates or deletes one, and nobody can move it to another
    // group or hand it to another owner.
    function teamGroupId(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.groupId;
    }
    function teamExists(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId));
    }

    match /teams/{teamId} {
      // A team that doesn't exist (yet) reads as missing rather than denied:
      // its new group reaches members' listeners before the team doc is
      // written, and a denied listener would stop for good.
      allow read: if signedIn() && (resource == null || isGroupMember(resource.data.groupId));
      allow create: if signedIn()
        && request.resource.data.id == teamId
        && request.resource.data.ownerUid == request.auth.uid
        && groupData(request.resource.data.groupId).ownerUid == request.auth.uid
        && groupData(request.resource.data.groupId).teamId == teamId;
      allow update: if isGroupMember(resource.data.groupId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn()
        && groupData(resource.data.groupId).ownerUid == request.auth.uid;

      match /combinations/{combinationId} {
        allow read: if signedIn() && (!teamExists(teamId) || isGroupMember(teamGroupId(teamId)));
        allow write: if isGroupMember(teamGroupId(teamId));
      }
      match /calcs/{calcId} {
        allow read: if signedIn() && (!teamExists(teamId) || isGroupMember(teamGroupId(teamId)));
        allow write: if isGroupMember(teamGroupId(teamId));
      }

      // The team's activity log (src/lib/firebase/teamActivity.ts): members
      // add entries as themselves and can only extend their own; nobody
      // edits anyone else's. Only the owner deletes — when ending the team.
      match /activity/{entryId} {
        allow read: if signedIn() && (!teamExists(teamId) || isGroupMember(teamGroupId(teamId)));
        allow create: if isGroupMember(teamGroupId(teamId))
          && request.resource.data.id == entryId
          && request.resource.data.by.uid == request.auth.uid;
        allow update: if isGroupMember(teamGroupId(teamId))
          && resource.data.by.uid == request.auth.uid
          && request.resource.data.by.uid == request.auth.uid
          && request.resource.data.id == entryId;
        allow delete: if signedIn()
          && groupData(teamGroupId(teamId)).ownerUid == request.auth.uid;
      }
    }

    // Invite links: knowing the code is the access, so a signed-in user can
    // get one by its code but nobody can list them. Only the group's owner
    // creates or removes them.
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && groupData(request.resource.data.groupId).ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && groupData(resource.data.groupId).ownerUid == request.auth.uid;
    }

    // The public Damage Calculator sets (src/types/calcSet.ts,
    // src/lib/firebase/publicSets.ts) — same everyone-reads/staff-writes
    // shape as seasons. A user's own sets live under users/{uid}/calcSets,
    // covered by the rule at the top.
    match /publicSets/{setId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Shared app config, read by every visitor: the per-section feature
    // flags (src/types/featureFlags.ts, /admin/features) are admin-only;
    // the rest — learnset overrides, meta spreads (metaSpreads_{regulation})
    // — staff keep.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if (docId == "featureFlags" && isAdmin())
        || (docId != "featureFlags" && isStaff());
    }

    // The metagame summary per regulation (see PLANNING.md's "Metagame
    // data" and scripts/update-meta.mjs) — every visitor reads it; nobody
    // writes it from the app. The job writes with a service account, which
    // bypasses these rules.
    match /meta/{regulationId} {
      allow read: if true;
      allow write: if false;

      // Each tournament's own summary, for the Metagame page's tournament chips.
      match /tournaments/{tournamentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // The job's anonymized copy of each official event it has processed —
    // its own bookkeeping, never read by the app.
    match /metaEvents/{eventId} {
      allow read, write: if false;
    }

    // Events uploaded by hand at /admin/meta-events (src/lib/meta/metaImport.ts),
    // already anonymous, waiting for the metagame job to save them as events.
    match /metaImports/{eventId} {
      allow read, create, update, delete: if isStaff();
    }
  }
}
