# Firebase web app config — from Firebase console > Project settings > Your apps > SDK setup and configuration.
# Copy this file to .env.local and fill in real values; .env.local is gitignored and never committed.
# These are NEXT_PUBLIC_ because they're read client-side (see src/lib/firebase/config.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server only (never NEXT_PUBLIC_): lets staff start the metagame job from /admin/meta-events.
# A fine-grained GitHub token for this repository only, with "Actions: read and write".
# See src/lib/server/metaWorkflow.ts.
META_JOB_GITHUB_TOKEN=
