{
  "name": "vgc-match-planner",
  "version": "0.2.2",
  "private": true,
  "description": "A personal tool for planning Pokémon VGC matchups — paste your team and opponent teams, then plan lead/back picks with notes.",
  "author": "thomasnrggo",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "generate:species": "node scripts/generate-species-data.mjs",
    "generate:moves": "node scripts/generate-move-data.mjs",
    "generate:items": "node scripts/generate-item-data.mjs",
    "generate:type-chart": "node scripts/generate-type-chart.mjs",
    "generate:names": "node scripts/generate-name-data.mjs",
    "generate:calc-data": "node scripts/generate-calc-data.mjs",
    "generate:learnsets": "node scripts/generate-learnsets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.38.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@pkmn/dex": "^0.10.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
